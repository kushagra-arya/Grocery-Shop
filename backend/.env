# Database Configuration
# 
# OPTION 1 - Use Supabase PostgreSQL (YOUR PRODUCTION DATABASE):
# Supabase URL (Connection Pooler):
DATABASE_URL="file:./prisma/dev.db"
# Uncomment above to connect to production Supabase for local testing
#
# Original template:
# DATABASE_URL="postgresql://user:pass@dpg-xxx.oregon-postgres.render.com/groceryshop"
#
# OPTION 2 - Use free cloud PostgreSQL for local dev:
# Sign up for free at https://neon.tech or https://supabase.com
# Then use their connection string:
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb"
#
# OPTION 3 - Temporary SQLite for local testing (will be ignored on Render):
# DATABASE_URL="file:./prisma/dev.db"
#
# NOTE: Render will automatically override DATABASE_URL with PostgreSQL in production

# JWT Secrets
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"
